{
	"name": "kit",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"installBuild": "bun install --frozen-lockfile && bun run build",
		"start": "bun build/index.js",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --ignore \"build\" --no-tsconfig",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@skeletonlabs/skeleton": "2.8.0",
		"@skeletonlabs/tw-plugin": "0.3.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/forms": "0.5.7",
		"@types/eslint": "8.56.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^22.20.2",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"autoprefixer": "^10.6.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"lucide-svelte": "^0.365.0",
		"postcss": "^8.5.28",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^3.4.19",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"vite-plugin-tailwind-purgecss": "^0.3.5",
		"vitest": "^4.1.11"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "1.6.1",
		"@trpc/client": "^11.18.0",
		"@trpc/server": "^11.18.0",
		"canvg": "^4.0.3",
		"isomorphic-dompurify": "2.24.0",
		"jsbarcode": "^3.12.3",
		"jsonwebtoken": "^9.0.3",
		"jspdf": "^4.2.1",
		"svelte-intersection-observer": "^1.2.0"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
