@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

/* Light theme polish: Skeleton paints cards with surface-100 (white) on a
   surface-50 page, so they need a slightly stronger edge than the default
   near-invisible ring to read as raised. Dark theme keeps Skeleton's defaults. */
:root:not(.dark) .card {
	--tw-ring-color: rgb(var(--color-surface-300) / 0.7);
	--tw-shadow: 0 1px 2px 0 rgb(16 24 40 / 0.04);
}

/* Form controls default to a surface-200 fill with a dark surface-400 border,
   which reads as a heavy grey block on the lightened page. White fill with a
   softer border keeps them legible without dominating. */
:root:not(.dark) :where(.input, .textarea, .select, .input-group) {
	background-color: rgb(var(--color-surface-100));
	border-color: rgb(var(--color-surface-300));
}

:root:not(.dark) .app-bar {
	box-shadow: inset 0 -1px 0 0 rgb(var(--color-surface-300) / 0.8);
}

/* Skeleton's ghost variants provide the tinted background and inset border,
   but otherwise inherit their text color. Keep button labels and icons paired
   with the same semantic color used by that border. */
.btn.variant-ghost-primary {
	color: rgb(var(--color-primary-500));
}

.btn.variant-ghost-secondary {
	color: rgb(var(--color-secondary-500));
}

.btn.variant-ghost-tertiary {
	color: rgb(var(--color-tertiary-500));
}

.btn.variant-ghost-success {
	color: rgb(var(--color-success-500));
}

.btn.variant-ghost-warning {
	color: rgb(var(--color-warning-500));
}

.btn.variant-ghost-error {
	color: rgb(var(--color-error-500));
}

.btn.variant-ghost-surface {
	color: rgb(var(--color-surface-500));
}

/* Consistent, visible focus ring for keyboard users across both themes. */
:where(a, button, input, select, textarea):focus-visible {
	outline: 2px solid rgb(var(--color-primary-500));
	outline-offset: 2px;
}

/* Skeleton's AppShell scrolls #page rather than the document, so with the default
   `auto` a classic scrollbar appears only on views tall enough to overflow it — and its
   arrival narrows everything inside, shifting the page header sideways. Holding the
   scrollbar permanently keeps that width constant, both between views and while a view
   grows as its data loads. `scrollbar-gutter: stable` expresses this better but needs
   Safari 18.2+, so it is not relied on. Overlay scrollbars reserve nothing either way,
   so this costs those platforms nothing. Printing overrides it in PrintOrder.svelte. */
#page {
	overflow-y: scroll;
}
